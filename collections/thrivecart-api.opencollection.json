                {
                  "name": "auto_resume",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Pause a subscription using the order ID and subscription ID pulled from either a Transaction search or the full history of a customer.\n\nNote that you can provide an optional timestamp to automatically resume the subscription on that date, or leave this blank to pause indefinitely."
        },
        {
          "info": {
            "name": "Resume a subscription",
