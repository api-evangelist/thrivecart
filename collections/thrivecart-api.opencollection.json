    {
      "info": {
        "name": "Transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://thrivecart.com/api/external/transactions",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number (1 through N)"
              },
              {
                "name": "perPage",
                "value": "10",
                "type": "query",
                "description": "Results per page (max of 100)"
              },
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Search query (e.g. customer email, order ID, etc)"
              },
              {
                "name": "transactionType",
                "value": "any",
                "type": "query",
                "description": "'any', 'charge', 'rebill', 'refund', 'cancel'"
              },
              {
                "name": "currency",
                "value": "",
                "type": "query",
                "description": "'usd', 'gbp', etc (optional; leave blank for all currencies)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Search through transaction events and return the info about activity within your account.\n\nEvents such as charges, rebills, refunds and cancellations will be included under the transaction_type key."
        }
      ]
    },
    {
      "info": {
        "name": "Customers",
        "type": "folder"
