                {
                  "name": "subscription_id",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Cancel a subscription using the order ID and subscription ID pulled from either a Transaction search or the full history of a customer."
        },
        {
          "info": {
            "name": "Refund a transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://thrivecart.com/api/external/refund",
