            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Refund a specific transaction using the order ID and purchase reference pulled from either a Transaction search or the full history of a customer."
        },
        {
          "info": {
            "name": "Pause a subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://thrivecart.com/api/external/pauseSubscription",
